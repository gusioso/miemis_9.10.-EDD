       "start": 13.709,
       "end": 14.926,
       "text": "YOU'D HAVE TO"
      },
      {
       "start": 14.926,
       "end": 16.372,
       "text": "SPEND $11,574"
      },
      {
       "start": 16.372,
       "end": 18.122,
       "text": "EVERY SINGLE SECOND"
      }
     ]
    }
   ]
  },
