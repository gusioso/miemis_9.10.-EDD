   "lines": [
    {
     "text": "At midnight, your phone buzzes. One billion dollars just hit your account.",
     "file": "assets/vo/aa5271ac196d.wav",
     "start": 0.3,
     "end": 4.295,
     "caps": [
      {
       "start": 0.3,
       "end": 1.049,
       "text": "AT MIDNIGHT"
      },
      {
       "start": 1.049,
       "end": 2.098,
       "text": "YOUR PHONE BUZZES"
      },
      {
       "start": 2.098,
       "end": 2.947,
       "text": "$1,000,000,000"
      },
      {
       "start": 2.947,
       "end": 3.746,
       "text": "JUST HIT YOUR"
      },
      {
       "start": 3.746,
       "end": 4.295,
       "text": "ACCOUNT"
      }
     ]
    },
    {
     "text": "There's one rule. Spend all of it in twenty four hours. Anything left at midnight disappears. And you can't just give it away.",
     "file": "assets/vo/eae1380f11c1.wav",
     "start": 4.515,
     "end": 11.134,
     "caps": [
      {
       "start": 4.515,
       "end": 5.489,
       "text": "THERE'S ONE RULE"
      },
      {
       "start": 5.489,
       "end": 6.219,
       "text": "SPEND ALL OF"
      },
      {
       "start": 6.219,
       "end": 6.754,
       "text": "IT IN 24"
      },
      {
       "start": 6.754,
       "end": 7.192,
       "text": "HOURS"
      },
      {
       "start": 7.192,
       "end": 7.971,
       "text": "ANYTHING LEFT"
      },
      {
       "start": 7.971,
       "end": 9.236,
       "text": "AT MIDNIGHT DISAPPEARS"
      },
      {
       "start": 9.236,
       "end": 10.015,
       "text": "AND YOU CAN'T"
      },
      {
       "start": 10.015,
       "end": 10.745,
       "text": "JUST GIVE IT"
      },
      {
       "start": 10.745,
       "end": 11.134,
       "text": "AWAY"
      }
     ]
    }
   ]
  },
  {
